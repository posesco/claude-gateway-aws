      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "claude-gateway-db"
          },
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT p.email AS \"Desarrollador\", COALESCE(g.group_name, 'DevJunior') AS \"Grupo\", ROUND((COALESCE(g.monthly_limit_cents, 500) / 100.0)::numeric, 2) AS \"Tope Mensual ($)\", ROUND((COALESCE(SUM(s.cents) / 100.0, 0))::numeric, 4) AS \"Gasto Actual ($)\", ROUND(((COALESCE(SUM(s.cents), 0) / NULLIF(COALESCE(g.monthly_limit_cents, 500), 0)) * 100.0)::numeric, 2) AS \"% Usado\" FROM principal_emails p LEFT JOIN group_quotas g ON g.group_name = CASE WHEN COALESCE(p.groups::text, '') LIKE '%DevSenior%' OR p.email LIKE '%senior%' THEN 'DevSenior' WHEN COALESCE(p.groups::text, '') LIKE '%DevJunior%' OR p.email LIKE '%junior%' THEN 'DevJunior' ELSE 'claude-gateway-admins' END LEFT JOIN spend s ON s.principal = p.principal AND s.period = to_char(CURRENT_TIMESTAMP AT TIME ZONE 'UTC', 'YYYY-MM') GROUP BY p.email, g.group_name, g.monthly_limit_cents ORDER BY \"Gasto Actual ($)\" DESC;",
          "refId": "A"
        }
      ],
      "title": "Detalle de Consumo por Desarrollador vs Presupuesto Mensual (Alerta al 80%)",
      "type": "table"
    },
