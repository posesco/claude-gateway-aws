        {
          "datasource": {
            "type": "postgres",
            "uid": "claude-gateway-db"
          },
          "format": "time_series",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT to_timestamp(s.period, 'YYYY-MM-DD') AS \"time\", ROUND((SUM(s.cents) / 100.0)::numeric, 4) AS \"value\", COALESCE(p.email, s.principal) AS \"metric\" FROM spend s LEFT JOIN principal_emails p ON s.principal = p.principal WHERE s.period ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' GROUP BY 1, 3 ORDER BY 1 ASC;",
          "refId": "A"
        }
      ],
